. capture program drop post_estimands

. program define post_estimands
  1.     syntax, POSTname(name) SCENario(string)
  2.     local n = _N
  3. 
.     quietly summarize tau
  4.     local ate = r(mean)
  5.     post `postname' ("`scenario'") ("ATE") (`ate') (`n')
  6. 
.     quietly summarize tau if D == 1
  7.     local att = r(mean)
  8.     post `postname' ("`scenario'") ("ATT") (`att') (`n')
  9. 
.     quietly summarize tau if D == 0
 10.     local atu = r(mean)
 11.     post `postname' ("`scenario'") ("ATU") (`atu') (`n')
 12. 
.     quietly summarize tau if X == 0
 13.     post `postname' ("`scenario'") ("CATE_X0") (r(mean)) (`n')
 14. 
.     quietly summarize tau if X == 1
 15.     post `postname' ("`scenario'") ("CATE_X1") (r(mean)) (`n')
 16. 
.     quietly summarize y if D == 1
 17.     local y1 = r(mean)
 18.     quietly summarize y if D == 0
 19.     local naive = `y1' - r(mean)
 20.     post `postname' ("`scenario'") ("NAIVE") (`naive') (`n')
 21.     post `postname' ("`scenario'") ("SESGO_ATT") (`naive' - `att') (`n')
 22.     post `postname' ("`scenario'") ("DESV_NAIVE_ATE") (`naive' - `ate') (`
> n')
 23. 
.     quietly regress y D, vce(robust)
 24.     post `postname' ("`scenario'") ("COEF_REG_D") (_b[D]) (`n')
 25. end

