. capture program drop post_estimands

. program define post_estimands
  1.     syntax, POSTname(name) SCENario(string)
  2.     local n = _N
  3. 
.     quietly count if D == 0
  4.     post `postname' ("`scenario'") ("N_D0") (r(N)) (`n')
  5.     quietly count if D == 1
  6.     post `postname' ("`scenario'") ("N_D1") (r(N)) (`n')
  7. 
.     quietly summarize y if D == 0
  8.     local y0 = r(mean)
  9.     post `postname' ("`scenario'") ("MEDIA_Y_D0") (`y0') (`n')
 10.     quietly summarize y if D == 1
 11.     local y1 = r(mean)
 12.     post `postname' ("`scenario'") ("MEDIA_Y_D1") (`y1') (`n')
 13. 
.     quietly summarize tau
 14.     local ate = r(mean)
 15.     post `postname' ("`scenario'") ("ATE") (`ate') (`n')
 16.     quietly summarize tau if D == 1
 17.     local att = r(mean)
 18.     post `postname' ("`scenario'") ("ATT") (`att') (`n')
 19.     quietly summarize tau if D == 0
 20.     post `postname' ("`scenario'") ("ATU") (r(mean)) (`n')
 21.     quietly summarize tau if X == 0
 22.     post `postname' ("`scenario'") ("CATE_X0") (r(mean)) (`n')
 23.     quietly summarize tau if X == 1
 24.     post `postname' ("`scenario'") ("CATE_X1") (r(mean)) (`n')
 25. 
.     local naive = `y1' - `y0'
 26.     post `postname' ("`scenario'") ("NAIVE") (`naive') (`n')
 27.     post `postname' ("`scenario'") ("SESGO_ATT") (`naive' - `att') (`n')
 28.     post `postname' ("`scenario'") ("DESV_NAIVE_ATE") (`naive' - `ate') (`
> n')
 29. 
.     quietly regress y D, vce(robust)
 30.     local tcrit = invttail(e(df_r), 0.025)
 31.     post `postname' ("`scenario'") ("COEF_REG_D") (_b[D]) (`n')
 32.     post `postname' ("`scenario'") ("SE_ROBUST_REG_D") (_se[D]) (`n')
 33.     post `postname' ("`scenario'") ("IC95_INF_REG_D") (_b[D] - `tcrit'*_se
> [D]) (`n')
 34.     post `postname' ("`scenario'") ("IC95_SUP_REG_D") (_b[D] + `tcrit'*_se
> [D]) (`n')
 35.     post `postname' ("`scenario'") ("COEF_REG_CONSTANTE") (_b[_cons]) (`n'
> )
 36.     post `postname' ("`scenario'") ("SE_ROBUST_REG_CONSTANTE") (_se[_cons]
> ) (`n')
 37.     post `postname' ("`scenario'") ("IC95_INF_REG_CONSTANTE") (_b[_cons] -
>  `tcrit'*_se[_cons]) (`n')
 38.     post `postname' ("`scenario'") ("IC95_SUP_REG_CONSTANTE") (_b[_cons] +
>  `tcrit'*_se[_cons]) (`n')
 39. end

. 
