. * ================================================================
. * 4. MONTE CARLO: un D nuevo en cada repetición
. * ================================================================
. capture program drop one_random_assignment

. program define one_random_assignment, rclass
  1.     syntax, POPulation(string)
  2.     use "`population'", clear
  3.     generate byte D = (runiform() < .5)
  4.     generate double y = D*yd1 + (1-D)*yd0
  5.     quietly summarize y if D == 1
  6.     local y1 = r(mean)
  7.     quietly summarize y if D == 0
  8.     return scalar estimador = `y1'-r(mean)
  9. end

. 
. simulate estimador=r(estimador), reps(1000) seed(87634) nodots: one_random_as
> signment, population("`population'")

      Command: one_random_assignment,
                   population("/var/folders/_b/6m74tr516wjf3mps793mlkwm0000gn
                   > /T//St16391.000002")
    estimador: r(estimador)


. generate str16 escenario = "aleatorizacion"

. generate long rep = _n

. order escenario rep estimador

. sort escenario rep

