. capture program drop one_rep

. program define one_rep, rclass
  1.     syntax, POPulation(string) SCENario(string)
  2.     use "`population'", clear
  3.     drop D
  4.     if "`scenario'" == "seleccion" {
  5.         quietly summarize yd0
  6.         generate double p = invlogit((yd0-r(mean))/2)
  7.         generate byte D = (runiform() < p)
  8.     }
  9.     else {
 10.         generate byte D = (runiform() < 0.5)
 11.     }
 12.     generate double y = D*yd1 + (1-D)*yd0
 13.     generate double tau = yd1-yd0
 14.     quietly summarize tau if D == 1
 15.     local att = r(mean)
 16.     quietly summarize y if D == 1
 17.     local y1 = r(mean)
 18.     quietly summarize y if D == 0
 19.     return scalar sesgo = `y1' - r(mean) - `att'
 20. end

