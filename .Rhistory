# ============================================
# PREVIEW DEL CORREO (ejecutar antes de enviar)
# ============================================
# Crear un correo de prueba con el primer estudiante
email_preview <- crear_bienvenida(estudiantes$nombre[1])
# Ver preview en el navegador
email_preview
# ============================================
# ENVIAR CORREOS (ejecutar despues del preview)
# ============================================
# Enviar correos de bienvenida a cada estudiante
for (i in 1:nrow(estudiantes)) {
email <- crear_bienvenida(estudiantes$nombre[i])
smtp_send(
email = email,
from = "econometrianews@gmail.com",
to = as.character(trimws(estudiantes$correo[i])),
subject = "Bienvenida al curso de Econometria II - 2026-1",
credentials = creds_file("gmail_creds.json")
)
cat("Correo enviado a:", estudiantes$nombre[i], "-", estudiantes$correo[i], "\n")
Sys.sleep(2)  # Pausa de 2 segundos entre correos para evitar límites de Gmail
}
cat("\n¡Todos los correos han sido enviados!\n")
View(contenido)
