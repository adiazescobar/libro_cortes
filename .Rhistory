# PREVIEW: Ejecuta solo esta sección primero
# ============================================
#email_preview <- crear_bienvenida("Estudiante Ejemplo")
#email_preview  # Esto abre el preview en RStudio Viewer
# ============================================
# ENVIAR: Descomenta cuando estés listo
# ============================================
for (i in 1:nrow(estudiantes)) {
email <- crear_bienvenida(estudiantes$nombre[i])
smtp_send(
email = email,
from = "econometrianews@gmail.com",
to = as.character(trimws(estudiantes$correo[i])),
subject = "Bienvenida al curso de Econometría Avanzada",
credentials = creds_file("gmail_creds.json")
)
cat("Correo enviado a:", estudiantes$nombre[i], "\n")
}
